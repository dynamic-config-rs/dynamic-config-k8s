{
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "defaults": {
          "type": "object",
          "properties": {
            "cpuRequest": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "memoryRequest": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "memoryLimit": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "cpuLimit": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "fileMode": {
              "type": "string",
              "pattern": "^(0o?)?[0-7]{0,4}$",
              "description": "Fleet-default octal permissions for rendered files; empty = the agent's 0644."
            },
            "watchSeconds": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default watch interval in whole seconds; empty = 15."
            },
            "mode": {
              "type": "string",
              "enum": [
                "",
                "init",
                "sidecar",
                "both"
              ],
              "description": "Fleet-default injection mode; empty = sidecar."
            },
            "volumeMedium": {
              "type": "string",
              "enum": [
                "",
                "memory",
                "disk"
              ],
              "description": "Fleet-default volume medium; empty = memory."
            },
            "nativeSidecar": {
              "type": [
                "string",
                "boolean"
              ],
              "pattern": "^(true|false)?$",
              "description": "Fleet-default native-sidecar shape; empty = false."
            },
            "runAsUser": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent UID; empty = 65532, 0 refused."
            },
            "runAsGroup": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent GID; empty = 65532, 0 refused."
            },
            "metricsPort": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent metrics port; empty = no metrics endpoint.",
              "minimum": 1,
              "maximum": 65535
            },
            "env": {
              "type": "string",
              "description": "Fleet-wide agent environment, 'NAME=value, NAME=value'; a pod's agent-env overrides name by name."
            },
            "perStore": {
              "description": "Per-store defaults. Each store's settings are a map, or the equivalent grammar as one string.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            },
            "source": {
              "type": "string",
              "pattern": "^(consul|vault|config-server|firestore|git|redis|etcd|nats|s3)?[!?]?$",
              "description": "Fleet default source; a pod may then omit dynamic-config.rs/source. '!' pins, '?' opens."
            },
            "path": {
              "type": "string",
              "pattern": "^(/.*)?[!?]?$",
              "description": "Fleet default rendered-file path; per-pod path still wins unless pinned."
            },
            "overridable": {
              "type": [
                "string",
                "boolean"
              ],
              "pattern": "^(true|false)?$",
              "description": "Default override mode: 'true' (default) = annotations win; 'false' = installation-set values are pinned. Per-value '!'/'?' markers win either way."
            }
          },
          "additionalProperties": false
        },
        "pullSecret": {
          "type": "string",
          "description": "imagePullSecret name appended to injected pods; must exist in each injecting namespace"
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "description": "Kubernetes Events written by the injected agent about its own pod. Off: the sidecar carries no API credential otherwise.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "serviceAccounts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "dnsPolicy": {
          "type": "string"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "ClusterIssuer",
                    "Issuer"
                  ]
                }
              },
              "additionalProperties": false
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "selfSignedDays": {
          "type": "integer",
          "minimum": 1
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Ignore",
            "Fail"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "reinvocationPolicy": {
          "type": "string",
          "enum": [
            "Never",
            "IfNeeded"
          ]
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaceGating": {
          "type": "boolean"
        },
        "objectSelector": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "strategy": {
          "type": "object"
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "topologySpread": {
          "type": "boolean"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {}
          },
          "additionalProperties": false
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "selfRotate": {
          "type": "object",
          "additionalProperties": false,
          "description": "The webhook mints and rotates its own certificate, and patches its own caBundle; mutually exclusive with certManager.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "agentEnvAllow": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "sourceAllow": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "sourceDeny": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "allowEvents": {
          "description": "Whether a pod may set dynamic-config.rs/events. Mirrors agent.events.enabled.",
          "type": "boolean"
        },
        "allowTlsSkipVerify": {
          "description": "Whether a pod may set dynamic-config.rs/tls-skip-verify, which connects to its store without authenticating it. Off, and a cluster decision rather than a workload's.",
          "type": "boolean"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "labels": {
                  "type": "object"
                }
              }
            }
          }
        },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Whether the webhook resolves dynamic-config.rs/class against the cluster DynamicConfigClass objects. Off: the admission path calls the API server nowhere, and enabling this gives the webhook a cluster-wide read.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "agentImageAllow": {
          "type": "string",
          "description": "Comma-separated image prefixes a pod may name in dynamic-config.rs/agent-image. Empty means none."
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "spec": {
              "type": "object"
            }
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    },
    "nodeAgent": {
      "type": "object",
      "additionalProperties": false,
      "description": "One agent per node, delivering configuration as a CSI volume. Off: it holds every pod on the node credentials and runs as root.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "kubeletPath": {
          "type": "string"
        },
        "metricsPort": {
          "type": [
            "integer",
            "string"
          ]
        },
        "registrar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dynamic-config chart values"
}
