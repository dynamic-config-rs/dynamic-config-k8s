{
  "type": "object",
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "commonLabels": {
      "type": "object"
    },
    "commonAnnotations": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agent": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "defaults": {
          "type": "object",
          "properties": {
            "cpuRequest": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "memoryRequest": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "memoryLimit": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "cpuLimit": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(m|k|K|M|G|T|Ki|Mi|Gi|Ti)?)?$"
            },
            "fileMode": {
              "type": "string",
              "pattern": "^(0o?)?[0-7]{0,4}$",
              "description": "Fleet-default octal permissions for rendered files; empty = the agent's 0644."
            },
            "watchSeconds": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default watch interval in whole seconds; empty = 15."
            },
            "mode": {
              "type": "string",
              "enum": [
                "",
                "init",
                "sidecar",
                "both"
              ],
              "description": "Fleet-default injection mode; empty = sidecar."
            },
            "volumeMedium": {
              "type": "string",
              "enum": [
                "",
                "memory",
                "disk"
              ],
              "description": "Fleet-default volume medium; empty = memory."
            },
            "nativeSidecar": {
              "type": [
                "string",
                "boolean"
              ],
              "pattern": "^(true|false)?$",
              "description": "Fleet-default native-sidecar shape; empty = false."
            },
            "runAsUser": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent UID; empty = 65532, 0 refused."
            },
            "runAsGroup": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent GID; empty = 65532, 0 refused."
            },
            "metricsPort": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[0-9]*$",
              "description": "Fleet-default agent metrics port; empty = no metrics endpoint."
            },
            "env": {
              "type": "string",
              "description": "Fleet-wide agent environment, 'NAME=value, NAME=value'; a pod's agent-env overrides name by name."
            },
            "perStore": {
              "type": "object",
              "description": "Per-store defaults. Each store's settings are a map, or the equivalent grammar as one string.",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "integer",
                        "boolean"
                      ]
                    }
                  }
                ]
              }
            },
            "source": {
              "type": "string",
              "pattern": "^(consul|vault|config-server|firestore|git|redis|etcd|nats|s3)?[!?]?$",
              "description": "Fleet default source; a pod may then omit dynamic-config.rs/source. '!' pins, '?' opens."
            },
            "path": {
              "type": "string",
              "pattern": "^(/.*)?[!?]?$",
              "description": "Fleet default rendered-file path; per-pod path still wins unless pinned."
            },
            "overridable": {
              "type": [
                "string",
                "boolean"
              ],
              "pattern": "^(true|false)?$",
              "description": "Default override mode: 'true' (default) = annotations win; 'false' = installation-set values are pinned. Per-value '!'/'?' markers win either way."
            }
          },
          "additionalProperties": false
        },
        "pullSecret": {
          "type": "string",
          "description": "imagePullSecret name appended to injected pods; must exist in each injecting namespace"
        }
      },
      "additionalProperties": false
    },
    "webhook": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "hostNetwork": {
          "type": "boolean"
        },
        "dnsPolicy": {
          "type": "string"
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "certManager": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerRef": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "ClusterIssuer",
                    "Issuer"
                  ]
                }
              },
              "additionalProperties": false
            },
            "duration": {
              "type": "string"
            },
            "renewBefore": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "selfSignedDays": {
          "type": "integer",
          "minimum": 1
        },
        "failurePolicy": {
          "type": "string",
          "enum": [
            "Ignore",
            "Fail"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "reinvocationPolicy": {
          "type": "string",
          "enum": [
            "Never",
            "IfNeeded"
          ]
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "namespaceGating": {
          "type": "boolean"
        },
        "objectSelector": {
          "type": "object"
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "strategy": {
          "type": "object"
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "topologySpread": {
          "type": "boolean"
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {}
          },
          "additionalProperties": false
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "selfRotate": {
          "type": "object",
          "additionalProperties": false,
          "description": "The webhook mints and rotates its own certificate, and patches its own caBundle; mutually exclusive with certManager.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "agentEnvAllow": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "sourceAllow": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "sourceDeny": {
          "description": "A map of namespace to a list of names, or the equivalent grammar as one string.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer"
            },
            "serviceMonitor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "interval": {
                  "type": "string"
                },
                "labels": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "spec": {
              "type": "object"
            }
          }
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "rbac": {
          "type": "object",
          "properties": {
            "create": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "dynamic-config chart values"
}
