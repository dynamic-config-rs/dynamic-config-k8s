# The agent: one static-ish binary on distroless. Build with the
# workspace as context:
#   docker build -f docker/Dockerfile.operator -t dynamic-config-operator .
FROM rust:1.88-slim AS build
WORKDIR /src
COPY . .
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev protobuf-compiler \
 && cargo build --release -p dynamic-config-operator

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /src/target/release/dynamic-config-operator /usr/local/bin/
USER nonroot
ENTRYPOINT ["dynamic-config-operator"]
