{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo deny:*)",
      "Bash(rustup:*)",
      "Bash(just:*)",
      "Bash(helm lint:*)",
      "Bash(helm template:*)",
      "Bash(kubectl kustomize:*)",
      "Bash(kubectl explain:*)",
      "Bash(docker pull:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Bash(cargo publish:*)",
      "Bash(cargo release:*)",
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(cosign sign:*)",
      "Bash(oras push:*)",
      "Read(./**/*.creds)",
      "Read(./**/tls.key)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/contract-drift.sh"
          }
        ]
      }
    ]
  }
}
